# =============================================================
# iaundang — Environment Variables
# Salin ke .env.local dan isi nilainya.
#
# Di produksi (Cloudflare Workers) yang RAHASIA diset lewat
# `wrangler secret put`, bukan file ini. Yang tidak rahasia ada di
# wrangler.jsonc. Lihat CLOUDFLARE_SETUP.md.
# =============================================================

# ─── Database ────────────────────────────────────────────────
# Dipakai untuk dev lokal dan `prisma migrate`.
# Di Workers koneksi datang dari binding Hyperdrive, bukan variabel ini.
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# ─── Supabase Storage ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://[project-ref].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # RAHASIA

# ─── Sesi ────────────────────────────────────────────────────
# WAJIB — tidak ada nilai default. Minimal 32 karakter.
# Aplikasi akan gagal terang-terangan kalau ini kosong; itu disengaja.
# Buat dengan: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
#
# Catatan: nama lama JWT_SECRET masih diterima sebagai alias, tapi
# SESSION_SECRET adalah nama yang benar.
SESSION_SECRET=""                                   # RAHASIA

# ─── Admin ───────────────────────────────────────────────────
# WAJIB diisi. Kalau kosong, jalur "admin berdasarkan email" dimatikan
# total dan hanya role di dalam token yang berlaku.
ADMIN_EMAIL="admin@iaundang.online"

# ─── URL aplikasi ────────────────────────────────────────────
# NEXT_PUBLIC_* di-inline saat build — harus diset sebagai BUILD variable
# di Workers Builds, bukan hanya sebagai runtime var.
NEXT_PUBLIC_APP_URL="https://iaundang.online"
NEXT_PUBLIC_APP_DOMAIN="iaundang.online"

# ─── Email (Resend) ──────────────────────────────────────────
# Kosong = email hanya dicetak ke log, tidak dikirim.
RESEND_API_KEY=""                                   # RAHASIA
EMAIL_FROM="iaundang <halo@iaundang.online>"

# ─── Cron ────────────────────────────────────────────────────
# WAJIB. Kosong = route cron menolak semua panggilan.
CRON_SECRET=""                                      # RAHASIA

# ─── Pembayaran (Mayar) ──────────────────────────────────────
MAYAR_API_KEY=""                                    # RAHASIA
# WAJIB kalau webhook dipakai. Nilai kosong SELALU ditolak — dulu
# token kosong justru membuat webhook palsu diterima.
MAYAR_WEBHOOK_TOKEN=""                              # RAHASIA
